# WorkforceOS local/deployment configuration.
# Copy to your deployment secret manager or local environment. Never commit real values.

# Machine-to-machine credentials
WORKFORCEOS_INGEST_TOKEN=
WORKFORCEOS_VIEWER_TOKEN=
WORKFORCEOS_CONTROL_TOKEN=
WORKFORCEOS_CHAIRMAN_TOKEN=

# Browser session authentication
# SESSION_SECRET should be a high-entropy value of at least 32 characters.
WORKFORCEOS_SESSION_SECRET=
WORKFORCEOS_VIEWER_SECRET=
WORKFORCEOS_OPERATOR_SECRET=
WORKFORCEOS_CHAIRMAN_SECRET=

# External event signing
# EVENT_SIGNING_SECRET should be a separate high-entropy value of at least 32 characters.
WORKFORCEOS_EVENT_SIGNING_SECRET=

# Private organization directory / asset map
# JSON object with organizations, floors, departments, agents and assets.
# Keep real employee identities and internal location/recovery records in deployment configuration
# rather than baking them into this public repository.
WORKFORCEOS_DIRECTORY_JSON=

# Security switches
# Set to 1 on hosted production after browser authentication has been validated.
WORKFORCEOS_REQUIRE_READ_AUTH=0
# Set to 1 after every remote event source has its signing secret provisioned.
WORKFORCEOS_REQUIRE_SIGNED_EVENTS=0
# Built HTTPS deployments should use 1. Local HTTP development can use 0.
WORKFORCEOS_SECURE_COOKIES=1

# Autonomous operations
# Keep disabled until durable persistence, backup/restore, hosted security, and rollback gates pass.
WORKFORCEOS_ENABLE_OPERATIONS_LOOP=0
